    <!-- Interactive Script -->
    <script>
        // Chart.js Label Wrapper
        function wrapLabel(str, maxChars = 14) {
            if (typeof str !== 'string') return str;
            if (str.length <= maxChars) return str;
            const words = str.split(' ');
            const lines = [];
            let currentLine = '';
            words.forEach(word => {
                if ((currentLine + word).length > maxChars) {
                    if (currentLine.trim()) lines.push(currentLine.trim());
                    currentLine = word + ' ';
                } else {
                    currentLine += word + ' ';
                }
            });
            if (currentLine.trim()) lines.push(currentLine.trim());
            return lines;
        }

        // Initialize Charts
        let doughnutChart, barChart;

        window.onload = function() {
            initCharts();
            setupEventListeners();
            calculateBudget();
        };

        function initCharts() {
            // 1. Doughnut Chart
            const ctxDoughnut = document.getElementById('budgetDoughnutChart').getContext('2d');
            doughnutChart = new Chart(ctxDoughnut, {
                type: 'doughnut',
                data: {
                    labels: ['순수 건축비', '토지 취득', '토목/외부공사', '설계/감리', '가구/설비', '세금/등기', '예비비'],
                    datasets: [{
                        data: [36000, 10460, 5200, 3600, 2700, 1100, 4500],
                        backgroundColor: [
                            '#10B981', // Emerald (Architecture)
                            '#0EA5E9', // Sky (Land)
                            '#3B82F6', // Blue (Civil)
                            '#6366F1', // Indigo (Design)
                            '#F59E0B', // Amber (Appliances)
                            '#A855F7', // Purple (Tax)
                            '#F43F5E'  // Rose (Buffer)
                        ],
                        borderWidth: 2,
                        borderColor: '#FFFFFF'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                boxWidth: 12,
                                font: { size: 11, family: 'Pretendard' },
                                padding: 12
                            }
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    const value = context.raw || 0;
                                    const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                    const pct = ((value / total) * 100).toFixed(1);
                                    return ` ${context.label}: ${value.toLocaleString()}만 원 (${pct}%)`;
                                }
                            }
                        }
                    },
                    cutout: '62%'
                }
            });

            // 2. Bar Chart
            const ctxBar = document.getElementById('costBarChart').getContext('2d');
            const barLabels = ['순수 건축비', '토지(세금포함)', '토목·인입', '예비비', '설계·감리', '옵션 가구', '준공 세금'].map(l => wrapLabel(l, 10));

            barChart = new Chart(ctxBar, {
                type: 'bar',
                data: {
                    labels: barLabels,
                    datasets: [{
                        label: '지출 금액 (만 원)',
                        data: [36000, 10460, 5200, 4500, 3600, 2700, 1100],
                        backgroundColor: [
                            '#10B981',
                            '#0EA5E9',
                            '#3B82F6',
                            '#F43F5E',
                            '#6366F1',
                            '#F59E0B',
                            '#A855F7'
                        ],
                        borderRadius: 8
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return ` 금액: ${context.raw.toLocaleString()}만 원`;
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function(val) {
                                    return val.toLocaleString() + '만';
                                }
                            }
                        }
                    }
                }
            });
        }

        function setupEventListeners() {
            const inputs = [
                'sliderArea',
                'sliderCostPerPyeong',
                'sliderLandCost'
            ];
            inputs.forEach(id => {
                document.getElementById(id).addEventListener('input', calculateBudget);
            });

            document.querySelectorAll('input[name="landType"]').forEach(r => {
                r.addEventListener('change', calculateBudget);
            });

            document.querySelectorAll('input[name="permitType"]').forEach(r => {
                r.addEventListener('change', calculateBudget);
            });
        }

        function formatEokMan(manWon) {
            if (manWon >= 10000) {
                const eok = Math.floor(manWon / 10000);
                const remainder = Math.round(manWon % 10000);
                if (remainder === 0) {
                    return `${eok}억`;
                }
                return `${eok}억 ${remainder.toLocaleString()}만`;
            }
            return `${Math.round(manWon).toLocaleString()}만`;
        }

        function calculateBudget() {
            const area = parseInt(document.getElementById('sliderArea').value);
            const costPerPyeong = parseInt(document.getElementById('sliderCostPerPyeong').value);
            const landCost = parseInt(document.getElementById('sliderLandCost').value);
            const landType = document.querySelector('input[name="landType"]:checked').value;
            const permitType = document.querySelector('input[name="permitType"]:checked').value;

            // Update UI Labels
            document.getElementById('valArea').innerText = area;
            document.getElementById('valAreaM2').innerText = Math.round(area * 3.30578);
            document.getElementById('valCostPerPyeong').innerText = costPerPyeong.toLocaleString();
            document.getElementById('valLandCost').innerText = landCost.toLocaleString();

            // 1. Pure Construction Cost
            const pureCost = area * costPerPyeong;

            // 2. Land Acquisition + Tax
            const landTax = Math.round(landCost * 0.046); // 4.6% acquisition tax
            const landSum = landCost + landTax;

            // 3. Design, Permits & Supervision
            let designCost = Math.round(2400 * (area / 40));
            if (designCost < 1500) designCost = 1500;
            const surveyFee = 200;
            const permitAdminFee = 500;
            let supervisionFee = 0;
            if (permitType === 'permit') {
                supervisionFee = 500; // Mandatory supervision for permit
            }
            const designSupervision = designCost + surveyFee + permitAdminFee + supervisionFee;

            // 4. Civil Work & Infrastructure
            const civilWork = Math.round(2500 * (area / 40));
            const infraIn = 1200;
            const landscape = Math.round(1500 * (area / 40));
            const civilInfra = civilWork + infraIn + landscape;

            // 5. Built-in Furniture & Systems
            const appliances = Math.round(2700 * (area / 40));

            // 6. Surcharges & Building Tax
            const buildingAcquisitionTax = Math.round(pureCost * 0.0316); // Approx 3.16%
            let surcharge = 0;
            if (landType === 'nong') {
                surcharge = 1650; // Agriculture Preservation Charge
            } else if (landType === 'san') {
                surcharge = 1200; // Forest Alternative Resource Charge
            }
            const taxes = buildingAcquisitionTax + surcharge;

            // 7. Contingency Reserve Buffer (Approx 7~8% of subtotal)
            const subTotalWithoutBuffer = pureCost + landSum + designSupervision + civilInfra + appliances + taxes;
            const buffer = Math.round(pureCost * 0.125); // ~4,500 for 36,000

            // Grand Total
            const totalAll = subTotalWithoutBuffer + buffer;
            const totalNoLand = totalAll - landSum;
            const pureShare = ((pureCost / totalAll) * 100).toFixed(1);

            // Update DOM Results
            document.getElementById('outTotalAll').innerText = formatEokMan(totalAll);
            document.getElementById('outTotalNoLand').innerText = formatEokMan(totalNoLand) + ' 원';
            document.getElementById('outPureShare').innerText = pureShare + '%';
            document.getElementById('outPureCost').innerText = pureCost.toLocaleString();
            document.getElementById('outLandSum').innerText = landSum.toLocaleString();
            document.getElementById('outDesignSupervision').innerText = designSupervision.toLocaleString();
            document.getElementById('outCivilInfra').innerText = civilInfra.toLocaleString();
            document.getElementById('outAppliances').innerText = appliances.toLocaleString();
            document.getElementById('outTaxes').innerText = taxes.toLocaleString();
            document.getElementById('outBuffer').innerText = buffer.toLocaleString();

            // Update Doughnut & Bar Charts dynamically
            if (doughnutChart && barChart) {
                const newData = [
                    pureCost,
                    landSum,
                    civilInfra,
                    designSupervision,
                    appliances,
                    taxes,
                    buffer
                ];
                doughnutChart.data.datasets[0].data = newData;
                doughnutChart.update();

                barChart.data.datasets[0].data = [
                    pureCost,
                    landSum,
                    civilInfra,
                    buffer,
                    designSupervision,
                    appliances,
                    taxes
                ];
                barChart.update();
            }
        }
    </script>
